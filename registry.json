{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "clock-component",
  "homepage": "https://github.com/yashbharadwaj/clock-component",
  "items": [
    {
      "name": "clock-clock-24",
      "type": "registry:component",
      "title": "ClockClock 24",
      "description": "An animated 24-clock grid that spells out the current time. Cycles through wave, spiral, scatter, and time-display phases. Auto-follows the consumer's light/dark theme via CSS variables.",
      "dependencies": ["clsx", "tailwind-merge"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/clock-clock-24/clock-clock-24.tsx",
          "type": "registry:component",
          "target": "components/clock-clock-24.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "clock-panel": "oklch(0.920 0 0)",
          "clock-face": "oklch(0.960 0 0)",
          "clock-face-edge": "oklch(0.860 0 0)",
          "clock-rim": "oklch(0.790 0 0)",
          "clock-hand": "oklch(0.110 0 0)",
          "clock-dial-shadow": "inset 0 3px 8px rgba(0,0,0,0.16), inset 0 1px 3px rgba(0,0,0,0.20), inset 0 -2px 5px rgba(255,255,255,0.06)",
          "clock-shadow": "0 1px 4px rgba(0,0,0,0.08), 0 6px 24px rgba(0,0,0,0.10)"
        },
        "dark": {
          "clock-panel": "oklch(15.907% 0.00002 271.152)",
          "clock-face": "oklch(0.138 0 0)",
          "clock-face-edge": "oklch(0.090 0 0)",
          "clock-rim": "oklch(0.220 0 0)",
          "clock-hand": "oklch(0.970 0 0)",
          "clock-dial-shadow": "inset 0 3px 8px rgba(0,0,0,0.48), inset 0 1px 3px rgba(0,0,0,0.55), inset 0 -2px 5px rgba(255,255,255,0.04)",
          "clock-shadow": "0 2px 10px rgba(0,0,0,0.45), 0 10px 36px rgba(0,0,0,0.40)"
        }
      }
    }
  ]
}
