{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "clock-component",
  "homepage": "https://github.com/yashbharadwaj/clock-component",
  "items": [
    {
      "name": "clock-clock-24",
      "type": "registry:component",
      "title": "ClockClock 24",
      "description": "An animated 24-clock grid that spells out the current time. Cycles through wave, spiral, scatter, and time-display phases. Auto-follows the consumer's light/dark theme via CSS variables.",
      "dependencies": ["clsx", "tailwind-merge"],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/clock-clock-24/clock-clock-24.tsx",
          "type": "registry:component",
          "target": "components/clock-clock-24.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "clock-panel": "oklch(0.93 0 0)",
          "clock-face": "oklch(0.965 0 0)",
          "clock-hand": "oklch(0.18 0 0)",
          "clock-shadow": "0 20px 60px rgba(0, 0, 0, 0.1)"
        },
        "dark": {
          "clock-panel": "oklch(0.07 0 0)",
          "clock-face": "oklch(0.135 0 0)",
          "clock-hand": "oklch(0.93 0 0)",
          "clock-shadow": "0 20px 60px rgba(0, 0, 0, 0.8)"
        }
      }
    }
  ]
}
