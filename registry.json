{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "clock-component",
  "homepage": "https://github.com/yashbharadwaj/clock-component",
  "items": [
    {
      "name": "clock-clock-24",
      "type": "registry:component",
      "title": "ClockClock 24",
      "description": "An animated 24-clock grid that spells out the current time. Cycles through wave, spiral, scatter, and time-display phases. Auto-follows the consumer's light/dark theme via CSS variables.",
      "dependencies": ["clsx", "tailwind-merge"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/clock-clock-24/clock-clock-24.tsx",
          "type": "registry:component",
          "target": "components/clock-clock-24.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "clock-panel": "oklch(0.965 0 0)",
          "clock-face": "oklch(1.000 0 0)",
          "clock-face-edge": "oklch(0.965 0 0)",
          "clock-rim": "oklch(0.905 0 0)",
          "clock-hand": "oklch(0.130 0 0)",
          "clock-shadow": "0 1px 2px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06)"
        },
        "dark": {
          "clock-panel": "oklch(0.125 0 0)",
          "clock-face": "oklch(0.185 0 0)",
          "clock-face-edge": "oklch(0.160 0 0)",
          "clock-rim": "oklch(0.245 0 0)",
          "clock-hand": "oklch(0.930 0 0)",
          "clock-shadow": "0 1px 2px rgba(0,0,0,0.35), 0 8px 24px rgba(0,0,0,0.50)"
        }
      }
    }
  ]
}
